# de-omarchy requires NO secrets to function.
# If YOUR local scripts need tokens, keep them out of git like this:
#   1. cp .env.example ~/.config/de-omarchy/secrets.env
#   2. fill values in that file (it is outside the repo)
#   3. source it from your shell rc if needed
# Example placeholders only:
# GITHUB_TOKEN=
# WEATHER_API_KEY=
